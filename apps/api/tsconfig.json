{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "include": [
    "src/**/*.ts",
    "identity/**/*.ts",
    "opportunity/**/*.ts",
    "marketplace/**/*.ts",
    "payments/**/*.ts",
    "intelligence/**/*.ts",
    "credentials/**/*.ts",
    "governance/**/*.ts",
    "communication/**/*.ts"
  ]
}
