# Server-side only. Never prefix private values with NEXT_PUBLIC_.
# The API listens on API_PORT=4000 in the repository root environment example.
VOLITION_API_URL=http://localhost:4000

# AuthKit callback for this app's /business basePath. Add the exact URI to the
# WorkOS redirect allowlist for the Business Workspace environment.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3003/business/callback

# AuthKit sign-out return URI. Add the exact URI to the WorkOS sign-out
# redirect allowlist. The destination is a public route, not the protected
# workspace root.
WORKOS_SIGN_OUT_REDIRECT_URI=http://localhost:3003/business/signed-out
